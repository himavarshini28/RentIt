// This file creates a mock API for testing when the backend is not available
export const setupMockApi = () => {
  // Check if we're in development mode and should use mock API
  const useMockApi = import.meta.env.VITE_USE_MOCK_API === 'true';
  
  console.log('Mock API enabled:', useMockApi);
  
  if (useMockApi) {
    console.log('Setting up mock API interceptors...');
    
    // Save original fetch
    const originalFetch = window.fetch;
    
    // Create a simple in-memory storage
    const mockStorage = {
      users: [
        {
          id: '1',
          fullName: 'John Doe',
          email: 'john@example.com',
          phoneNumber: '123-456-7890',
        }
      ],
      properties: [
        {
          id: '1',
          name: 'Modern Apartment in City Center',
          description: 'Beautiful modern apartment with all amenities',
          price: 1500,
          location: 'New York, NY',
          bedrooms: 2,
          bathrooms: 1,
          imageUrls: 'https://images.unsplash.com/photo-1522708323590-d24dbb6b0267',
          featured: true,
        },
        {
          id: '2',
          name: 'Cozy Studio Near Campus',
          description: 'Perfect for students, close to university',
          price: 900,
          location: 'Boston, MA',
          bedrooms: 1,
          bathrooms: 1,
          imageUrls: 'https://images.unsplash.com/photo-1560448204-e02f11c3d0e2',
          featured: false,
        }
      ],
    };
    
    // Helper to create Response objects
    function createResponse(data, status = 200) {
      return Promise.resolve({
        ok: status >= 200 && status < 300,
        status,
        json: async () => data,
        text: async () => JSON.stringify(data),
      });
    }
    
    // Mock fetch implementation
    window.fetch = async (url, options = {}) => {
      console.log(`Mock API intercepting request to: ${url}`);
      
      try {
        // Mock signup endpoint
        if (url.includes('signup')) {
          console.log('Handling signup request');
          const body = options.body ? JSON.parse(options.body) : {};
          
          // Check if email exists
          if (mockStorage.users.some(u => u.email === body.email)) {
            return createResponse({ message: 'Email already in use' }, 409);
          }
          
          const newUser = {
            id: Date.now().toString(),
            fullName: body.fullName || (body.firstName + ' ' + body.lastName),
            email: body.email,
            phoneNumber: body.phoneNumber || '555-555-5555',
          };
          
          mockStorage.users.push(newUser);
          
          return createResponse({
            message: "User created successfully",
            user: newUser,
            token: 'mock-token-' + Date.now()
          }, 200);
        }
        
        // Mock login endpoint
        if (url.includes('login')) {
          console.log('Handling login request');
          const body = JSON.parse(options.body);
          
          // For testing, accept any email with password "password"
          if (body.password === 'password') {
            return createResponse({
              user: { 
                id: '1',
                fullName: 'Test User',
                email: body.email,
                phoneNumber: '555-555-5555'
              },
              token: 'mock-token-12345'
            }, 200);
          }
          
          return createResponse({ message: 'Invalid credentials' }, 401);
        }
        
        // Mock profile endpoint
        if (url.includes('me')) {
          console.log('Handling profile request');
          const authHeader = options.headers?.Authorization;
          
          if (authHeader && authHeader.startsWith('Bearer mock-token')) {
            return createResponse(mockStorage.users[0], 200);
          }
          
          return createResponse({ message: 'Unauthorized' }, 401);
        }
        
        // Mock get all properties endpoint
        if (url.includes('get-properties')) {
          console.log('Handling get properties request');
          return createResponse({
            message: "fetched all properties",
            properties: mockStorage.properties
          }, 200);
        }
        
        // Mock get property by ID endpoint
        if (url.match(/get-property\/[^\/]+$/)) {
          console.log('Handling get property by ID request');
          const id = url.split('/').pop();
          const property = mockStorage.properties.find(p => p.id === id);
          
          if (property) {
            return createResponse({
              message: "property found",
              property
            }, 200);
          }
          
          return createResponse({ message: 'Property not found' }, 404);
        }
        
        // Mock any other property endpoint
        if (url.includes('property')) {
          console.log('Handling generic property request');
          return createResponse({
            message: "fetched properties",
            properties: mockStorage.properties
          }, 200);
        }
        
        // Fallback to real fetch for other requests
        return originalFetch(url, options);
      } catch (error) {
        console.error('Error in mock API:', error);
        return createResponse({ 
          message: 'Mock API error', 
          error: error.message 
        }, 500);
      }
    };
  }
};
